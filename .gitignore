node_modules/
dist/
*.log
.DS_Store
Thumbs.db

# Build output — regenerated by `npm run build`
FIELDKIT-STANDALONE.html
OUTPOST-STANDALONE.html

# The drive manifest describes a particular copy of the payload, and
# PREFLIGHT re-hashes files against it. Committing one would mean the
# repo carried hashes for whatever the last build happened to contain,
# which is exactly the sort of stale trust anchor it exists to avoid.
drive-manifest.json

# Never commit anything that could carry real data or secrets.
#
# config.local.json holds the real values — tokens, the tunnel
# credential, the moderator list. config.json is GENERATED from it by
# `node build.js`, so both are secret and neither is authored by hand
# in the repo. relay/config.example.json IS committed: it is the
# annotated schema, with placeholders where the secrets go.
relay/config.json
relay/config.local.json
relay/data/
*.vault.json

# Tailscale state and credentials — never commit
relay/tailscale-authkey.txt
relay/.tailscale/
relay/tailscaled
relay/tailscale
relay/tailscale-bin/

# cloudflared binary — 38 MB, fetched by relay/fetch-cloudflared.js
relay/cloudflared-bin/
relay/cloudflared
relay/cloudflared.yml
relay/.cloudflared/

# Vault recovery keys. A recovery key is a second credential of equal
# power to the password — it unwraps the same master key — so one in
# the repo is the whole vault in the repo. Named broadly because the
# file that appears is whatever the browser's download prompt was
# given, and it is never something git should see.
recoverykey.txt
*recovery*.txt
*recovery-key*

# The release signing key. Its whole purpose is that the relay can be
# taken over completely and still not produce a build FieldKit will
# accept — which stops being true the moment this is anywhere but the
# SSD. The PUBLIC half lives in core/update-key.js and is committed.
release-key.json

# Built by `node build.js --release`: the signed standalone builds and
# their release.json, staged for upload. Derived output, and it would
# put a second copy of every build in the history.
release/

# Downloaded blocklists. Megabytes of somebody else’s data, refetchable
# with tools/fetch-blocklist.js, and not ours to vendor.
release/blocklists/
relay/data/blocklists/

# Deploy bundles. They hold the real config.json.
deploy/

# Local secrets, in case one is ever created here
.env
*.env
*.pem
*.key
answers.env

# Personal words for tools/publish-github.js
tools/publish-private.json

# Local editor and preview settings
.claude/
